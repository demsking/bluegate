# BlueGate Environment Configuration
# ============================================================
# All settings can also be set as environment variables directly.
# Every application setting uses the BLUEGATE_ prefix.
# ============================================================

# -- Server Settings -------------------------------------------------------------
# Host address to bind the server to. Use 0.0.0.0 to listen on all interfaces.
BLUEGATE_SERVER_HOST=127.0.0.1

# Port number to bind the server to. Must be between 1 and 65535.
BLUEGATE_SERVER_PORT=8765

# API prefix/root path for deployments behind a reverse proxy.
BLUEGATE_API_PREFIX=/

# Allowed CORS origins for browser-based UI clients.
# Supported formats:
# - Comma-separated: http://localhost:8080,https://ui.example.com
BLUEGATE_CORS_ALLOWED_ORIGINS=http://localhost:8080

# -- Logging Settings ------------------------------------------------------------
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
BLUEGATE_LOG_LEVEL=INFO

# Path to log file. Leave unset to use the default configured by Settings.
# BLUEGATE_LOG_FILE=/var/log/bluegate.log
