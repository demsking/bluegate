# JSON array of BlueGate nodes with upstream server mapping.
# The entrypoint uses this to build nginx proxy routes and generate /nodes.json.
# Example:
# BLUEGATE_NODES_JSON=[{"id":"node-a","name":"Node A","server":"http://bluegate-node-a:8765"},{"id":"node-b","name":"Node B","server":"http://bluegate-node-b:8765"}]
BLUEGATE_NODES_JSON=[{"id":"local","name":"Localhost","server":"http://localhost:8765"},{"id":"bamenda","name":"Bamenda","server":"http://192.168.1.60:18765"}]
