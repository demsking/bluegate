# JSON array of BlueGate API nodes available in the dashboard.
# Example:
# UI_NODES_JSON=[{"id":"node-a","name":"Node A","apiBaseUrl":"http://node-a:8765"},{"id":"node-b","name":"Node B","apiBaseUrl":"http://node-b:8765"}]
UI_NODES_JSON=[{"id":"local","name":"Local node","apiBaseUrl":"http://127.0.0.1:8765"}]

# Default selected node id at startup.
UI_DEFAULT_NODE_ID=local
